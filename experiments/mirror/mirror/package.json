{
  "name": "dsh-wsl-mirror",
  "version": "0.0.0-experiment",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "description": "Experiment: runs in the Desktop-side Host and merges the user plugin rows of a WSL Host's client module graph into its own, serving their bundles from the WSL Host.",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "manifestVersion": 1
  },
  "files": [
    "*.mjs",
    "client.js",
    "cordis.patch.yml",
    "transport/",
    "agent/"
  ]
}
